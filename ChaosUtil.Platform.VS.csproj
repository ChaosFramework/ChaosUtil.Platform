<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import
    Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props"
    Condition="Exists('$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props')"
    />

  <PropertyGroup>
    <ProjectStyle>VS</ProjectStyle>
    <COM_Supported>true</COM_Supported>
    <DefineConstants>$(DefineConstants);COM_Supported</DefineConstants>
  </PropertyGroup>

  <Import Project="submodules/ChaosPresets.Targets/Frameworks/net4.5.2.targets" />
  <Import Project="submodules/ChaosPresets.Targets/Paths/Output/bin.targets" />
  <Import Project="ChaosUtil.Platform.props" />

  <!-- Included Files -->
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="source\**\*.cs" />

    <None Include="License\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Default Targets for Building CSharp Projects -->
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
</Project>